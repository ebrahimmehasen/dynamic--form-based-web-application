@page "/admin"
@model StudentRegistry.API.Pages.Admin.HomeModel
@{
    ViewData["Title"] = "لوحة تحكم الإدارة";
}

<div class="container review-page-container">
  <header class="app-header">
    <h1 class="app-title">لوحة تحكم الإدارة</h1>
    <p class="app-subtitle">مراجعة نشاط المحررين — تعديلات، تعليقات، وطلبات حذف الطلاب</p>
  </header>

  <div class="form-section">
    <div class="editor-tabs">
      <button type="button" class="editor-tab-btn editor-tab-active" id="admin-tab-btn-dashboard">لوحة الإحصائيات</button>
      <button type="button" class="editor-tab-btn" id="admin-tab-btn-delete">طلبات الحذف</button>
      <button type="button" class="editor-tab-btn" id="admin-tab-btn-edits">التعديلات</button>
      <button type="button" class="editor-tab-btn" id="admin-tab-btn-comments">التعليقات</button>
      <button type="button" class="editor-tab-btn" id="admin-tab-btn-users">إدارة المستخدمين</button>
      <button type="button" class="editor-tab-btn" id="admin-tab-btn-records">سجلات الطلاب</button>
    </div>

    <div id="admin-tab-dashboard">
      <div class="dashboard-filters">
        <div class="dashboard-filter-group">
          <label class="review-field-label" for="dashboard-start-date">من تاريخ</label>
          <input type="date" id="dashboard-start-date" class="table-input">
        </div>
        <div class="dashboard-filter-group">
          <label class="review-field-label" for="dashboard-end-date">إلى تاريخ</label>
          <input type="date" id="dashboard-end-date" class="table-input">
        </div>
        <div class="dashboard-filter-group">
          <label class="review-field-label" for="dashboard-cert-filter">الشهادة</label>
          <select id="dashboard-cert-filter" class="table-input">
            <option value="">كل الشهادات</option>
          </select>
        </div>
        <div class="dashboard-filter-actions">
          <button type="button" class="btn btn-primary" id="dashboard-apply-filters" style="width:auto;">تطبيق الفلاتر</button>
          <button type="button" class="btn btn-secondary" id="dashboard-reset-filters" style="width:auto;">إعادة تعيين</button>
        </div>
      </div>

      <div class="dashboard-kpi-grid" id="dashboard-kpi-grid"></div>

      <div class="dashboard-filter-actions" style="margin-bottom:16px;">
        <button type="button" class="btn btn-primary" id="dashboard-export-eligible" style="width:auto;">تحميل الطلاب المستوفين (Excel)</button>
        <button type="button" class="btn btn-secondary" id="dashboard-export-not-eligible" style="width:auto;">تحميل الطلاب غير المستوفين (Excel)</button>
      </div>

      <div class="dashboard-widgets-grid">
        <div class="dashboard-widget">
          <h3 class="dashboard-widget-title">الطلاب حسب الشهادة</h3>
          <div id="dashboard-students-per-cert"></div>
        </div>
        <div class="dashboard-widget">
          <h3 class="dashboard-widget-title">التعليقات حسب الشهادة</h3>
          <div id="dashboard-comments-per-cert"></div>
        </div>
      </div>

      <div class="dashboard-widget">
        <h3 class="dashboard-widget-title">الشهادات الخارجية (أخرى)</h3>
        <p class="field-hint">شهادات محددة سجّلها الطلاب ضمن خيار "أخرى" وليست من ضمن القائمة الرئيسية المعروضة.</p>
        <div id="dashboard-other-certs"></div>
      </div>

      <div class="dashboard-filter-actions" style="margin-top:16px;">
        <button type="button" class="btn btn-primary" id="dashboard-export-all" style="width:auto;">تحميل كل البيانات (Excel)</button>
      </div>
    </div>

    <div id="admin-tab-delete" style="display:none;">
      <div class="editor-audit-filters">
        <select id="admin-delete-status-filter" class="table-input">
          <option value="pending">قيد المراجعة</option>
          <option value="approved">تمت الموافقة</option>
          <option value="rejected">مرفوض</option>
          <option value="">الكل</option>
        </select>
      </div>
      <div id="admin-delete-body"></div>
    </div>

    <div id="admin-tab-edits" style="display:none;">
      <div class="editor-audit-filters">
        <label class="editor-admin-checkbox">
          <input type="checkbox" id="admin-edits-from-comment-only">
          إظهار التعديلات الناتجة عن تعليقات فقط
        </label>
      </div>
      <div id="admin-edits-body"></div>
    </div>

    <div id="admin-tab-comments" style="display:none;">
      <div id="admin-comments-body"></div>
    </div>

    <div id="admin-tab-users" style="display:none;">
      <div class="editor-audit-filters">
        <button type="button" class="btn btn-primary admin-add-user-btn" id="admin-add-user-btn" style="width:auto;">+ إضافة مستخدم</button>
        <input type="text" id="admin-users-search-input" class="table-input" placeholder="ابحث بالاسم...">
        <select id="admin-users-status-filter" class="table-input">
          <option value="">كل الحالات</option>
          <option value="active">نشط</option>
          <option value="disabled">معطّل</option>
        </select>
      </div>
      <div id="admin-users-body"></div>
    </div>

    <!-- Same UI/data as the Editor's Student Records Editor page (/editor) — reuses editor-page.js
         unmodified against these identical element ids so Admins get the exact same search/edit/
         comment/eligibility/PDF experience Editors have, without duplicating any logic. -->
    <div id="admin-tab-records" style="display:none;">
      <div class="form-section">
        <div class="review-search-row">
          <input type="text" id="editor-search-input" class="table-input review-search-input"
                 placeholder="ابحث بالاسم، الرقم القومي، الهاتف، البريد الإلكتروني، الشهادة، المحافظة...">
        </div>
        <p class="field-hint" id="editor-results-banner"></p>
      </div>

      <div class="form-section">
        <div class="table-responsive">
          <table class="grades-table data-table">
            <thead>
              <tr>
                <th>اسم الطالب</th>
                <th>الاسم بالإنجليزية</th>
                <th>الرقم القومي</th>
                <th>الهاتف</th>
                <th>البريد الإلكتروني</th>
                <th>المحافظة</th>
                <th>الشهادة</th>
                <th>المسار</th>
                <th>سنة التخرج</th>
                <th>تاريخ التقديم</th>
                <th>الحالة</th>
                <th>الاستيفاء</th>
                <th>سبب عدم الاستيفاء</th>
              </tr>
            </thead>
            <tbody id="editor-table-body">
            </tbody>
          </table>
        </div>
        <p class="field-hint" id="editor-empty-state" style="display:none;">لا توجد نتائج مطابقة لبحثك.</p>
        <div class="editor-pagination" id="editor-pagination"></div>
      </div>
    </div>
  </div>

  <!-- Large student profile modal (Student Records Editor parity — see admin-tab-records above) -->
  <div class="app-modal-overlay" id="editor-detail-overlay">
    <div class="app-modal-box review-modal-lg" id="editor-detail-box">
      <div class="review-modal-header">
        <h3 class="app-modal-title" id="editor-detail-title"></h3>
        <div class="editor-modal-header-actions">
          <span id="editor-delete-badge" class="editor-pending-badge" style="display:none;">حذف معلق — بانتظار مراجعة المسؤول</span>
          <span id="editor-pending-review-badge" class="pending-review-badge" style="display:none;">قيد المراجعة</span>
          <button type="button" class="btn btn-secondary" id="editor-resolve-pending-review-btn" style="display:none;">إزالة علامة قيد المراجعة</button>
          <span id="editor-eligibility-badge" class="eligibility-badge" style="display:none;"></span>
          <button type="button" class="btn btn-secondary eligibility-btn-eligible" id="editor-mark-eligible-btn">مستوفي ✓</button>
          <button type="button" class="btn btn-secondary eligibility-btn-not-eligible" id="editor-mark-not-eligible-btn">غير مستوفي ✗</button>
          <button type="button" class="btn btn-secondary" id="editor-download-pdf-btn">تنزيل PDF 📄</button>
          <button type="button" class="btn btn-secondary editor-request-delete-btn" id="editor-request-delete-btn">طلب حذف الطالب</button>
          <button type="button" class="review-modal-close" id="editor-detail-close" aria-label="إغلاق">&times;</button>
        </div>
      </div>
      <div class="editor-tabs">
        <button type="button" class="editor-tab-btn editor-tab-active" id="editor-tab-btn-details">البيانات</button>
        <button type="button" class="editor-tab-btn" id="editor-tab-btn-audit">سجل التعديلات</button>
      </div>
      <div class="app-modal-body editor-detail-tab active" id="editor-detail-tab-details">
        <div id="editor-detail-body"></div>
      </div>
      <div class="app-modal-body editor-detail-tab" id="editor-detail-tab-audit" style="display:none;">
        <div class="editor-audit-filters">
          <select id="editor-audit-type-filter" class="table-input">
            <option value="">كل الأنواع</option>
            <option value="Edit">تعديل</option>
            <option value="Comment">تعليق</option>
            <option value="DeleteRequest">طلب حذف</option>
          </select>
          <input type="text" id="editor-audit-field-filter" class="table-input" placeholder="تصفية حسب اسم الحقل...">
        </div>
        <div id="editor-audit-body"></div>
      </div>
    </div>
  </div>

  <!-- Small field-comment modal, stacked above the profile modal -->
  <div class="app-modal-overlay" id="editor-field-overlay">
    <div class="app-modal-box" id="editor-field-box">
      <div class="review-modal-header">
        <h3 class="app-modal-title" id="editor-field-title">تعليق على الحقل</h3>
        <button type="button" class="review-modal-close" id="editor-field-close" aria-label="إغلاق">&times;</button>
      </div>
      <div class="app-modal-body">
        <label class="review-field-label">القيمة الحالية</label>
        <div class="review-field-current" id="editor-field-current"></div>

        <div id="editor-field-history-wrap" style="display:none;">
          <label class="review-field-label">التعليقات السابقة</label>
          <div class="review-field-history" id="editor-field-history"></div>
        </div>

        <label class="review-field-label" for="editor-field-comment-input">تعليق جديد</label>
        <textarea id="editor-field-comment-input" class="table-input review-field-textarea" rows="3"
                  placeholder="اكتب تعليقك هنا..."></textarea>
      </div>
      <div class="app-modal-footer">
        <button type="button" class="btn btn-secondary" id="editor-field-cancel" style="flex:1;">إلغاء</button>
        <button type="button" class="btn btn-primary" id="editor-field-save" style="flex:1;">حفظ التعليق</button>
      </div>
    </div>
  </div>

  <!-- Generic confirmation modal (used by Approve/Reject/Request Deletion) -->
  <div class="app-modal-overlay" id="app-modal-overlay">
    <div class="app-modal-box" id="app-modal-box">
      <h3 class="app-modal-title" id="app-modal-title"></h3>
      <div class="app-modal-body" id="app-modal-body"></div>
      <div class="app-modal-footer">
        <button type="button" class="btn btn-secondary" id="app-modal-cancel" style="flex:1;">إلغاء</button>
        <button type="button" class="btn btn-primary" id="app-modal-confirm" style="flex:1;">تأكيد</button>
      </div>
    </div>
  </div>

  <!-- User add/edit/change-password modal -->
  <div class="app-modal-overlay" id="admin-user-modal-overlay">
    <div class="app-modal-box" id="admin-user-modal-box">
      <h3 class="app-modal-title" id="admin-user-modal-title"></h3>
      <div class="app-modal-body" id="admin-user-modal-body"></div>
      <div class="app-modal-footer">
        <button type="button" class="btn btn-secondary" id="admin-user-modal-cancel" style="flex:1;">إلغاء</button>
        <button type="button" class="btn btn-primary" id="admin-user-modal-save" style="flex:1;">حفظ</button>
      </div>
    </div>
  </div>

  <div class="app-toast-container" id="app-toast-container"></div>
</div>

@section Scripts {
  <script src="~/js/app-modal.js" asp-append-version="true"></script>
  <script src="~/js/editor-shared.js" asp-append-version="true"></script>
  <script src="~/js/admin-review.js" asp-append-version="true"></script>
  <script src="~/js/admin-users.js" asp-append-version="true"></script>
  <script src="~/js/admin-dashboard.js" asp-append-version="true"></script>
  <script src="~/js/editor-page.js" asp-append-version="true"></script>
}
